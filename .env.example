# Variables de entorno del frontend (Vite las expone con VITE_*).
# Todas tienen default seguro en el código: la app arranca sin este archivo.
# OJO: cualquier VITE_* termina en el bundle público (es una PWA estática).

# URL del API de stock (backend en Render)
VITE_STOCK_API_URL=https://g360-stock-api.onrender.com/api/v1/stock

# Clave de SOLO LECTURA para el payload de stock.
# Nunca poner aquí la clave administrativa (upload/catálogo).
VITE_STOCK_READ_KEY=cipsa2026
